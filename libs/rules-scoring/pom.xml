<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.tenantmetrics</groupId>
		<artifactId>tenant-metrics-api</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<artifactId>rules-scoring</artifactId>
	<name>rules-scoring</name>
	<description>Shared RULES_BASELINE scorer. Not a microservice. No Spring, MongoDB, or Redis.</description>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>ban-mongodb-and-redis</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<bannedDependencies>
									<searchTransitive>true</searchTransitive>
									<excludes>
										<exclude>org.mongodb:*</exclude>
										<exclude>org.springframework.boot:spring-boot-starter-data-mongodb*</exclude>
										<exclude>org.springframework.data:spring-data-mongodb*</exclude>
										<exclude>org.springframework.boot:spring-boot-starter-data-redis*</exclude>
										<exclude>org.springframework.data:spring-data-redis*</exclude>
										<exclude>io.lettuce:lettuce-core</exclude>
										<exclude>redis.clients:jedis</exclude>
									</excludes>
									<message>rules-scoring must not depend on MongoDB or Redis, including transitive libraries.</message>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
