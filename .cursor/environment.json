{
  "name": "tenant-metrics-api",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "platform-service",
      "description": "Approved Spring Boot modular monolith on http://localhost:8080",
      "command": "cd apps/platform-service && ../../mvnw -ntp spring-boot:run -Dspring-boot.run.profiles=local"
    },
    {
      "name": "worker",
      "description": "Approved same-version background worker",
      "command": "cd apps/worker && ../../mvnw -ntp spring-boot:run"
    },
    {
      "name": "console",
      "description": "Angular console on http://localhost:4200",
      "command": "cd apps/console && npm start"
    }
  ],
  "ports": [
    { "name": "platform-service", "port": 8080 },
    { "name": "console", "port": 4200 },
    { "name": "localstack", "port": 4566 }
  ]
}
